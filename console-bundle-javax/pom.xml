<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ibm.liberty.admin</groupId>
        <artifactId>console-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>console-bundle-javax</artifactId>
    <packaging>jar</packaging>

    <name>Liberty Admin Console - Servlet 3.0 Web Application Bundle</name>
    <description>
        OSGi Web Application Bundle (WAB) that contains the console UI and its REST API.
        Bnd generates the OSGi manifest from bnd.bnd.
    </description>

    <dependencies>
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.framework</artifactId>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>org.osgi.service.component.annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.ibm.websphere.appserver.spi</groupId>
            <artifactId>com.ibm.websphere.appserver.spi.wab.configure</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- Liberty convention: <symbolic name>_<version>.jar -->
        <finalName>${bundle.symbolicName}.javax_${project.version}</finalName>

        <!-- Generate the legacy adapter from the same sources; do not maintain two implementations. -->
        <sourceDirectory>${project.build.directory}/generated-sources/console</sourceDirectory>
        <testSourceDirectory>${project.build.directory}/generated-test-sources/console</testSourceDirectory>
        <resources>
            <!-- OSGi metadata (metatype, l10n) -->
            <resource>
                <directory>../console-bundle/src/main/resources</directory>
            </resource>
            <!-- Web content is served from the root of the WAB -->
            <resource>
                <directory>${project.build.directory}/generated-webapp</directory>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-javax-adapter</id>
                        <phase>generate-sources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <copy todir="${project.build.directory}/generated-sources/console" overwrite="true">
                                    <fileset dir="../console-bundle/src/main/java"/>
                                    <filterchain><replacestring from="jakarta.servlet" to="javax.servlet"/></filterchain>
                                </copy>
                                <copy todir="${project.build.directory}/generated-test-sources/console" overwrite="true">
                                    <fileset dir="../console-bundle/src/test/java"/>
                                    <filterchain><replacestring from="jakarta.servlet" to="javax.servlet"/></filterchain>
                                </copy>
                                <copy todir="${project.build.directory}/generated-webapp" overwrite="true">
                                    <fileset dir="../console-bundle/src/main/webapp"/>
                                </copy>
                                <replace file="${project.build.directory}/generated-webapp/WEB-INF/web.xml">
                                    <replacefilter token="https://jakarta.ee/xml/ns/jakartaee" value="http://java.sun.com/xml/ns/javaee"/>
                                    <replacefilter token="web-app_5_0.xsd" value="web-app_3_0.xsd"/>
                                    <replacefilter token='version="5.0"' value='version="3.0"'/>
                                </replace>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>biz.aQute.bnd</groupId>
                <artifactId>bnd-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bnd-process</id>
                        <goals>
                            <goal>bnd-process</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.config.file>${project.basedir}/../console-bundle/src/test/resources/logging.properties</java.util.logging.config.file>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <!-- Use the manifest that bnd generated -->
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
