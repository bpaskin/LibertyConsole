Subsystem-ManifestVersion: 1
IBM-Feature-Version: 2
Subsystem-Type: osgi.subsystem.feature
Subsystem-SymbolicName: ${feature.symbolicName}.javax; visibility:=private; singleton:=true
Subsystem-Version: ${feature.version}
Subsystem-Name: Liberty Admin Console (javax)
